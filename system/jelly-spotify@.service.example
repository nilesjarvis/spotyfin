# EXAMPLE systemd unit — sanitized for public release.
#
# Your own instantiated unit (system/jelly-spotify@system.service) is
# gitignored because it contains your <USER>, paths and node binary.
# To use this example, copy it and substitute every <PLACEHOLDER>:
#
#   sudo cp system/jelly-spotify@.service.example \
#          /etc/systemd/system/jelly-spotify.service
#   sudo nano /etc/systemd/system/jelly-spotify.service   # fill in placeholders
#   sudo systemctl daemon-reload \
#        && sudo systemctl enable --now jelly-spotify
#
# Substitution example (real values, not these placeholders):
#   User=alice
#   WorkingDirectory=/srv/jelly-spotify
#   ExecStart=/usr/bin/node /srv/jelly-spotify/server.js
#   Environment=PORT=5173 / HOST=0.0.0.0
#
[Unit]
Description=Jelly Spotify - Spotify-clone music web app for Jellyfin
After=network-online.target jellyfin.service
Wants=network-online.target

[Service]
Type=simple
User=<USER>
Group=<USER>
WorkingDirectory=<REPO_DIR>
# Replace <NODE_BIN> with the absolute path to your node binary,
# e.g. /usr/bin/node or /home/<you>/.local/bin/node
ExecStart=<NODE_BIN> <REPO_DIR>/server.js
Environment=PORT=5173
Environment=HOST=0.0.0.0
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=<REPO_DIR>

[Install]
WantedBy=multi-user.target
